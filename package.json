{
	"name": "jsdoc-plugin-dependency-graph",
	"version": "0.2.0",
	"description": "JSDoc plugin that puts a clickable module dependency graph on the Home page",
	"keywords": [
		"jsdoc",
		"jsdoc-plugin",
		"dependency-graph",
		"dependency-cruiser",
		"graphviz",
		"documentation"
	],
	"homepage": "https://hd140283.github.io/jsdoc-plugin-dependency-graph/",
	"bugs": "https://github.com/hd140283/jsdoc-plugin-dependency-graph/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hd140283/jsdoc-plugin-dependency-graph.git"
	},
	"license": "MIT",
	"author": "Taiki Watanabe",
	"type": "module",
	"main": "./index.cjs",
	"exports": {
		".": "./index.cjs"
	},
	"files": [
		"index.cjs",
		"lib",
		"assets"
	],
	"engines": {
		"node": ">=22"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^22 || ^24 || >=26",
			"onFail": "error"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "12",
			"onFail": "error"
		}
	},
	"scripts": {
		"lint": "biome check --write",
		"test": "vitest run --coverage",
		"docs": "jsdoc -c jsdoc.json"
	},
	"peerDependencies": {
		"jsdoc": "^4.0.0"
	},
	"dependencies": {
		"@hpcc-js/wasm-graphviz": "^1.30.0",
		"dependency-cruiser": "^18.7.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@vitest/coverage-v8": "^5.0.5",
		"jsdoc": "^4.0.5",
		"jsdom": "^31.0.0",
		"vitest": "^5.0.5"
	},
	"packageManager": "pnpm@12.16.1"
}
